# SentinelAgent Configuration
# If keys are left blank, SentinelAgent automatically runs in Smart Dual-Mode
# (Realistic sandboxed threat intel + embedded heuristic reasoning engine)

# --- Optional LLM API Keys (Pick ANY one or leave blank) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Optional Threat Intel Keys (Free tiers or leave blank for sandbox) ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# --- Server Config ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
